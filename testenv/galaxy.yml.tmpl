# Minimal Galaxy 26.1 for exercising byoc-sync end to end (prebuilt web client from PyPI).
gravity:
  galaxy_root: @GALAXY_ROOT@
  gunicorn:
    bind: 127.0.0.1:@GALAXY_PORT@
    workers: 1
  celery:
    enable: false
    enable_beat: false
galaxy:
  database_connection: postgresql://galaxy:galaxy@127.0.0.1:@PG_PORT@/galaxy
  admin_users: admin@example.org
  bootstrap_admin_api_key: @ADMIN_KEY@
  user_preferences_extra_conf_path: @TESTENV@/user_preferences_extra_conf.yml
  # EU's form keeps the Invenio token in Galaxy's vault (store: vault), so Galaxy needs one configured.
  vault_config_file: @TESTENV@/state/vault_conf.yml
  allow_user_creation: true
  allow_user_deletion: true
  require_login: false
  conda_auto_init: false
  check_migrate_databases: true
  database_auto_migrate: true
