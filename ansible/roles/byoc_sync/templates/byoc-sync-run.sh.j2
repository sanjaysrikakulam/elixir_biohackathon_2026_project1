#!/bin/sh
# Managed by Ansible (byoc_sync role). Runs byoc-sync with the options configured in the role.
# Run it as {{ byoc_sync_user }}: sudo -u {{ byoc_sync_user }} {{ byoc_sync_wrapper_path }} [more byoc-sync options]
set -eu
umask 077
PATH={{ (byoc_sync_venv ~ '/bin:/usr/local/bin:/usr/bin:/bin') | string | quote }}
export PATH

user={{ byoc_sync_user | string | quote }}
if [ "$(id -un)" != "$user" ]; then
  echo "byoc-sync-run: run as $user, e.g. sudo -u $user "{{ byoc_sync_wrapper_path | string | quote }} >&2
  exit 1
fi
{% if _byoc_sync_run_missing | length > 0 %}
echo "byoc-sync-run: set these variables first: {{ _byoc_sync_run_missing | join(', ') }}" >&2
exit 1
{% endif %}

env_file={{ (byoc_sync_config_dir ~ '/env') | string | quote }}
vault_file={{ (byoc_sync_config_dir ~ '/vault-password') | string | quote }}
reports={{ byoc_sync_reports_dir | string | quote }}
for file in "$env_file" "$vault_file"; do
  if [ ! -r "$file" ]; then
    echo "byoc-sync-run: cannot read $file" >&2
    exit 1
  fi
done
# shellcheck disable=SC1090
. "$env_file"

# One run at a time: a second run while the first holds the lock does nothing (flock exits 1 when busy).
exec 9>>"$reports/.byoc-sync.lock"
status=0
flock -n 9 || status=$?
if [ "$status" -eq 1 ]; then
  echo "byoc-sync-run: another byoc-sync run is in progress" >&2
  exit 0
elif [ "$status" -ne 0 ]; then
  echo "byoc-sync-run: flock failed (exit $status); is util-linux installed?" >&2
  exit 1
fi

report="$reports/report-$(date -u +%Y%m%dT%H%M%SZ).json"
set -- \
  --site-config {{ byoc_sync_site_config | string | quote }} \
  --source {{ byoc_sync_source | string | quote }} \
  --repo-url {{ byoc_sync_playbook_repo_url | string | quote }} \
  --workdir {{ byoc_sync_work_dir | string | quote }} \
  --vault-password-file "$vault_file" \
  --report-json "$report" \
{% if byoc_sync_source == 'api' %}
  --galaxy-url {{ byoc_sync_galaxy_url | string | quote }} \
{% else %}
  --gxadmin-cmd {{ byoc_sync_gxadmin_cmd | string | quote }} \
{% endif %}
{% if _byoc_sync_github_repo_set | bool %}
  --github-repo {{ byoc_sync_github_repo | string | quote }} \
{% endif %}
{% if byoc_sync_dry_run | bool %}
  --dry-run \
{% endif %}
{% if byoc_sync_allow_delete | bool %}
  --allow-delete \
{% endif %}
{% for arg in byoc_sync_extra_args %}
  {{ arg | string | quote }} \
{% endfor %}
  "$@"
exec {{ (byoc_sync_venv ~ '/bin/byoc-sync') | string | quote }} "$@"
